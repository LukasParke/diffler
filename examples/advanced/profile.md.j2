### 🔭 Recent Releases
{% set recent_rels = releases(github.user.login, config.github.token, limit=5) -%}
{% for rel in recent_rels -%}
- [{{ rel.repo }} {{ rel.tag }}]({{ rel.url }}) — {{ rel.name }} ({{ humanize(rel.published_at) }})
{% endfor %}

### ⭐ Recent Stars
{% set starred = recent_stars(github.user.login, config.github.token, limit=5) -%}
{% for star in starred -%}
- [{{ star.full_name }}]({{ star.url }}){% if star.description %} — {{ star.description }}{% endif %}
{% endfor %}

### 📜 My Recent Dev.to Posts
{% set posts = devto_posts("lukeparke", limit=5) -%}
{% for post in posts -%}
- [{{ post.title }}]({{ post.url }}) ({{ humanize(post.published_at) }})
{% endfor %}

