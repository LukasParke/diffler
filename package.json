{
  "name": "diffler-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for diffler CLI, stats-action engine, and remotion renderer",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "diffler": "npm run diffler -w packages/diffler",
    "render": "npm run render -w packages/remotion --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
