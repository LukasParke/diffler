{
  "name": "diffler-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for diffler CLI, stats-action engine, and remotion renderer",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "diffler": "pnpm --filter diffler diffler",
    "render": "pnpm --filter @diffler/remotion render"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
