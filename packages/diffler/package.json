{
  "name": "@lukasparke/diffler",
  "version": "0.1.0",
  "description": "A powerful, extensible engine for generating and managing GitHub profile READMEs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "bin": {
    "diffler": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LukasParke/diffler.git",
    "directory": "packages/diffler"
  },
  "homepage": "https://github.com/LukasParke/diffler#readme",
  "bugs": {
    "url": "https://github.com/LukasParke/diffler/issues"
  },
  "scripts": {
    "build": "tsc",
    "build:action": "node scripts/bundle-action.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "diffler": "node dist/cli.js"
  },
  "keywords": [
    "github",
    "profile",
    "readme",
    "automation",
    "generator",
    "markdown",
    "template",
    "nunjucks"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "nunjucks": "^3.2.4",
    "yaml": "^2.8.4",
    "zod": "4.4.3",
    "@lukasparke/diffler-schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nunjucks": "^3.2.6",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
