{# Remotion cards & highlights template.

   Generates the metric cards and highlight badges that remotion
   renders in its "main-stats" and "stats" scenes.
#}
{% set cards = [
  {"id": "contributions", "label": "Contributions", "value": stats.profileContributions.totalContributions},
  {"id": "commits", "label": "Commits", "value": stats.profileContributions.totalCommitContributions},
  {"id": "pull-requests", "label": "Pull Requests", "value": stats.activity.totalPullRequests | default(stats.profileContributions.totalPullRequestContributions)},
  {"id": "issues", "label": "Issues Closed", "value": stats.activity.closedIssues | default(0)},
  {"id": "repositories", "label": "Repositories", "value": stats.repoMetrics.publicRepoCount | default(0)},
  {"id": "stars", "label": "Stars Earned", "value": stats.repoMetrics.starCount | default(0)},
  {"id": "followers", "label": "Followers", "value": stats.followers | default(0)}
] %}
{% set highlights = [] %}
{% if stats.profileContributions.stats.currentStreak >= 7 %}
{% set _ = highlights.append({"id": "streak", "label": "🔥 Streak", "value": stats.profileContributions.stats.currentStreak ~ " days", "detail": "Longest: " ~ stats.profileContributions.stats.longestStreak ~ " days"}) %}
{% endif %}
{% if stats.repoMetrics.starCount >= 50 %}
{% set _ = highlights.append({"id": "popular", "label": "⭐ Popular", "value": stats.repoMetrics.starCount ~ " stars"}) %}
{% endif %}
{% if stats.activity.repositoriesContributedTo >= 5 %}
{% set _ = highlights.append({"id": "contributor", "label": "🌐 Contributor", "value": stats.activity.repositoriesContributedTo ~ " repos"}) %}
{% endif %}
{% if stats.computedStats.yearOverYearGrowth > 0 %}
{% set _ = highlights.append({"id": "growth", "label": "📈 Growth", "value": "+" ~ stats.computedStats.yearOverYearGrowth ~ "%", "detail": "Year over year"}) %}
{% endif %}
{{ {"cards": cards, "highlights": highlights} | tojson(indent=2) }}
