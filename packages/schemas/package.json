{
  "name": "@lukasparke/diffler-schemas",
  "version": "0.1.0",
  "description": "Shared TypeScript types and Zod schemas for diffler stats output",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LukasParke/diffler.git",
    "directory": "packages/schemas"
  },
  "homepage": "https://github.com/LukasParke/diffler#readme",
  "bugs": {
    "url": "https://github.com/LukasParke/diffler/issues"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
