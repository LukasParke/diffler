{
  "name": "@lukasparke/diffler-schemas",
  "version": "0.1.0",
  "description": "Shared TypeScript types and Zod schemas for diffler stats output",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./v2": {
      "import": {
        "types": "./dist/v2.d.ts",
        "default": "./dist/v2.js"
      },
      "require": {
        "types": "./dist/v2.d.cts",
        "default": "./dist/v2.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LukasParke/diffler.git",
    "directory": "packages/schemas"
  },
  "homepage": "https://github.com/LukasParke/diffler#readme",
  "bugs": {
    "url": "https://github.com/LukasParke/diffler/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts src/v2.ts src/zod.ts --format esm,cjs --dts --sourcemap --clean --target es2022",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
