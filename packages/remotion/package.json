{
  "name": "@lukasparke/diffler-remotion",
  "version": "0.1.0",
  "description": "Remotion components and helpers for generating animated GitHub profile README cards",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cards": {
      "import": {
        "types": "./dist/cards/index.d.ts",
        "default": "./dist/cards/index.js"
      },
      "require": {
        "types": "./dist/cards/index.d.cts",
        "default": "./dist/cards/index.cjs"
      }
    },
    "./themes": {
      "import": {
        "types": "./dist/themes/index.d.ts",
        "default": "./dist/themes/index.js"
      },
      "require": {
        "types": "./dist/themes/index.d.cts",
        "default": "./dist/themes/index.cjs"
      }
    },
    "./render": {
      "import": {
        "types": "./dist/render/index.d.ts",
        "default": "./dist/render/index.js"
      },
      "require": {
        "types": "./dist/render/index.d.cts",
        "default": "./dist/render/index.cjs"
      }
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LukasParke/diffler.git",
    "directory": "packages/remotion"
  },
  "homepage": "https://github.com/LukasParke/diffler#readme",
  "bugs": {
    "url": "https://github.com/LukasParke/diffler/issues"
  },
  "bin": {
    "github-readme-cards": "./dist/render/cli.js"
  },
  "scripts": {
    "build": "tsup && node scripts/build-styles.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "dev": "tsup --watch src --onSuccess \"node scripts/build-styles.mjs\"",
    "test": "vitest run",
    "test:render": "pnpm prepare:stats --stats-file fixtures/github-user-stats.json && node scripts/render-assets.mjs --cards=readme --formats=webp,gif,png --out-dir=.render-smoke",
    "typecheck": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext ts,tsx,js,jsx",
    "prepare:stats": "node scripts/prepare-stats.mjs",
    "render": "pnpm render:all",
    "render:all": "node scripts/render-assets.mjs --formats=webp,gif,png",
    "render:webp": "node scripts/render-assets.mjs --formats=webp",
    "render:gif": "node scripts/render-assets.mjs --formats=gif"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.509",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@lukasparke/diffler-schemas": "workspace:*",
    "@remotion/bundler": "4.0.509",
    "@remotion/renderer": "4.0.509",
    "clsx": "^2.1.1",
    "lucide-react": "^0.446.0",
    "tailwind-merge": "^2.5.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fontsource/fira-code": "5.2.7",
    "@remotion/cli": "4.0.509",
    "@remotion/eslint-config": "4.0.509",
    "@remotion/eslint-plugin": "4.0.509",
    "@remotion/tailwind": "4.0.509",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "8.57.1",
    "eslint-plugin-10x": "1.5.2",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "postcss": "8.5.23",
    "prettier": "^3.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.509",
    "tailwindcss": "3.4.13",
    "tsup": "8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
